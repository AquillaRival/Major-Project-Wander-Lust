<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust</title>
  </head>
  <body>
    <h3>Create New Listing</h3>
    <form action="/listings" method="POST">
      <label
        >Title:
        <input type="text" name="listing[title]" placeholder="eg: Ramya Stays"
      /></label>
      <br /><br />
      <label
        >Image:
        <input
          type="text"
          name="listing[image]"
          placeholder="eg: https//myphoto......"
      /></label>
      <br /><br />
      <label
        >Description:
        <input
          type="text"
          name="listing[description]"
          placeholder="eg: Serene Environment"
      /></label>
      <br /><br />
      <label
        >Price:
        <input type="number" name="listing[price]" placeholder="eg: 2800"
      /></label>
      <br /><br />
      <label
        >Location:
        <input
          type="text"
          name="listing[location]"
          placeholder="eg: Vrindavan, UP"
      /></label>
      <br /><br />
      <label
        >Country:
        <input type="text" name="listing[country]" placeholder="eg: INDIA"
      /></label>
      <br /><br />
      <button>Submit</button>
    </form>
  </body>
</html>
