<input
  type="hidden"
  name="listing[geometry][coordinates][0]"
  id="lng-input"
  value="<%= typeof listing !== 'undefined' && listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[0] : '' %>"
/>
<input
  type="hidden"
  name="listing[geometry][coordinates][1]"
  id="lat-input"
  value="<%= typeof listing !== 'undefined' && listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[1] : '' %>"
/>

<div class="mb-3">
  <label class="form-label">Drag map to pin exact location:</label>
  <div style="position: relative; width: 100%; height: 350px">
    <div
      id="picker-map"
      style="width: 100%; height: 100%; border-radius: 10px"
    ></div>

    <!-- Fixed Center Pin CSS Overlay -->
    <div
      style="
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -100%);
        pointer-events: none;
        z-index: 10;
      "
    >
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="#fe424d"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
        />
      </svg>
    </div>
  </div>
</div>
